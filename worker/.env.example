# Set in Cloudflare via `wrangler secret put <NAME>` for production, and
# mirror to .dev.vars (gitignored) for `wrangler dev`. Do NOT commit a real
# .env — this file documents variable names only.

# Address that receives the $0.01 USDC per lookup.
SERVER_PAY_TO_ADDRESS=

# Public RPC per https://docs.arc.io/arc/references/connect-to-arc
ARC_RPC_URL=https://rpc.mainnet.arc.io

# The USDC contract address is NOT an env var — it's imported as the ARC_USDC
# constant from the x402-arc package (src/constants.ts), which states it was
# verified on-chain 2026-09-18. No need to duplicate or override it here.
