# Demo agent wallet. Fund it with a small amount of USDC on Arc mainnet —
# this wallet pays both the $0.01 lookup price and its own gas (Arc gas is
# USDC), out of the same balance. Never commit a real key.
AGENT_PRIVATE_KEY=

# Your deployed worker, e.g. https://arc-risk-score-worker.<you>.workers.dev
API_URL=

# The Arc address to look up. Any valid address works for a demo.
TARGET_ADDRESS=
